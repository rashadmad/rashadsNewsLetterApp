# Local dev only. In AWS these are SAM parameters (see template.yaml).
PORT=3000
ADMIN_KEY=change-me-to-a-long-random-secret
# Read-only access to the store's Medusa
MEDUSA_URL=https://your-medusa.example.com
MEDUSA_ADMIN_API_KEY=
# Unsubscribe link in every email -> store page; secret is shared with the store
UNSUBSCRIBE_BASE_URL=https://your-store.example.com/unsubscribe
UNSUBSCRIBE_SECRET=change-me-another-long-random-secret
POSTAL_ADDRESS=Your business mailing address
# Leave MAIL_FROM empty for dry-run (logs instead of sending)
MAIL_FROM=
MAIL_REPLY_TO=
