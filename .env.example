PORT=3000
# Protects this app's API (header x-admin-key)
ADMIN_KEY=change-me-to-a-long-random-secret
DB_PATH=./data/newsletter.db
# Where the newsletter list lives (read-only access)
MEDUSA_URL=https://your-medusa.example.com
MEDUSA_ADMIN_API_KEY=
